{
  "name": "cline-edu-desktop",
  "version": "1.0.0",
  "description": "ClineEdu - 小学数学 AI 老师桌面版 (Electron + Cline cline-core)",
  "main": "out/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dev": "node build.mjs && electron .",
    "rebuild-core": "node ../esbuild.mjs --standalone && node ../scripts/package-standalone.mjs -s",
    "rebuild-webview": "node scripts/build-webview.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "grpc-health-check": "^2.0.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.23.0"
  }
}
